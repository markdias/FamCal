# Supabase S3 Storage Configuration
# Copy this file to .env.local and fill in your AWS S3 credentials

# AWS S3 Configuration
S3_HOST=famcal-event-attachments.s3-us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your_aws_access_key_id_here
S3_SECRET_KEY=your_aws_secret_access_key_here

# Optional: OpenAI API Key for Supabase AI features
# OPENAI_API_KEY=your_openai_api_key_here
